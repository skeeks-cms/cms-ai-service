{
    "name": "skeeks/cms-ai-service",
    "description": "SkeekS AI central service",
    "keywords": [
        "yii",
        "skeeks",
        "cms",
        "ai"
    ],
    "homepage": "https://cms.skeeks.com/",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://skeeks.com/",
        "source": "https://github.com/skeeks-cms/cms-ai-service"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "skeeks/cms-mcp": "^1.0 || dev-master"
    },
    "autoload": {
        "psr-4": {
            "skeeks\\cms\\ai\\service\\": "src/"
        }
    },
    "extra": {
        "config-plugin": {
            "web": [
                "src/config/web.php"
            ],
            "console": [
                "src/config/console.php"
            ]
        }
    }
}
